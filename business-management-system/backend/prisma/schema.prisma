  @@unique([companyId, id])
  @@index([companyId, financialYearId, orderDate])
  @@index([companyId, financialYearId, status])
  @@index([companyId, financialYearId, expectedDeliveryDate])
  @@index([companyId, partyId])
  @@map("sales_orders")
}

model SalesOrderLine {
  id                   String        @id @default(uuid())
  companyId            String        @map("company_id")
