}

enum DebitNoteReason {
  CASH_DISCOUNT
  QUANTITY_DISCOUNT
  RATE_DIFFERENCE
  INTEREST
  TCS
  PURCHASE_RETURN
  WEIGHT_SHORTAGE
  QUALITY_DEDUCTION
  QUANTITY_SHORTAGE
  EXCESS_BILLING_ADJUSTMENT
  OTHER_PURCHASE_ADJUSTMENT
}

enum DebitNoteCalculationBasis {
  BILL_AMOUNT
  TAXABLE_AMOUNT
  BASIC_AMOUNT
}

enum DebitNoteStatus {
  DRAFT
  CONFIRMED
  POSTED
  CANCELLED
}

enum DebitNoteGstStatus {
  NOT_APPLICABLE
  AWAITING_SUPPLIER_CREDIT_NOTE
  RECEIVED
  VERIFIED
  RECONCILED
  REJECTED
}

model DebitNoteBook {
  id              String      @id @default(uuid())
  companyId       String      @map("company_id")
  financialYearId String      @map("financial_year_id")
  prefix          String // e.g. "DN-"
  bookName        String      @map("book_name") // e.g. "DEBIT NOTE"
  openingBalance  Decimal     @default(0.00) @map("opening_balance") @db.Decimal(15, 2)
  balanceType     BalanceType @default(CREDIT) @map("balance_type")
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  financialYear FinancialYear @relation(fields: [companyId, financialYearId], references: [companyId, id], onDelete: Cascade)
  debitNotes    DebitNote[]

  @@unique([companyId, id])
  @@unique([companyId, financialYearId, id])
  @@unique([companyId, financialYearId, bookName])
  @@unique([companyId, financialYearId, prefix])
  @@map("debit_note_books")
}

model DebitNote {
  id                       String                    @id @default(uuid())
  companyId                String                    @map("company_id")
  financialYearId          String                    @map("financial_year_id")
  bookId                   String                    @map("book_id")
  voucherNumber            Int                       @map("voucher_number")
  noteNumber               String                    @map("note_number")
  noteDate                 DateTime                  @map("note_date")
  partyNoteNo              String?                   @map("party_note_no")
  noteType                 DebitNoteType             @default(SALES) @map("note_type")
  partyId                  String                    @map("party_id")
  brokerId                 String?                   @map("broker_id")
  transporterId            String?                   @map("transporter_id")
  salespersonId            String?                   @map("salesperson_id")
  vehicleNumber            String?                   @map("vehicle_number")
  dueDays                  Int                       @default(0) @map("due_days")
  creditAccountId          String                    @map("credit_account_id")
  osEffect                 String                    @default("2.OS(+)") @map("os_effect")
  reason                   DebitNoteReason           @default(INTEREST)
  calculationBasis         DebitNoteCalculationBasis @default(BILL_AMOUNT) @map("calculation_basis")
  gstRate                  Decimal                   @default(5.00) @map("gst_rate") @db.Decimal(5, 2)
  tdsRate                  Decimal                   @default(0.00) @map("tds_rate") @db.Decimal(5, 2)
  tdsAmount                Decimal                   @default(0.00) @map("tds_amount") @db.Decimal(15, 2)
  tdsSection               String?                   @map("tds_section")
  tdsAccount               String?                   @default("TDS RECEIVABLE") @map("tds_account")
  remark                   String?
  adjustmentReason         String?                   @map("adjustment_reason")
  purchaseBillId           String?                   @map("purchase_bill_id")
  supplierName             String?                   @map("supplier_name")
  supplierGstin            String?                   @map("supplier_gstin")
  supplierAddress          String?                   @map("supplier_address")
  supplierState            String?                   @map("supplier_state")
  originalInvoiceNumber    String?                   @map("original_invoice_number")
  originalInvoiceDate      DateTime?                 @map("original_invoice_date")
  isManualReference        Boolean                   @default(false) @map("is_manual_reference")
  totalQuantity            Decimal                   @default(0.000) @map("total_quantity") @db.Decimal(15, 3)
  cessAmount               Decimal                   @default(0.00) @map("cess_amount") @db.Decimal(15, 2)
  stockMovementPosted      Boolean                   @default(false) @map("stock_movement_posted")
  revision                 Int                       @default(1)
  postedAt                 DateTime?                 @map("posted_at")
  gstStatus                DebitNoteGstStatus        @default(NOT_APPLICABLE) @map("gst_status")
  supplierCreditNoteNumber String?                   @map("supplier_credit_note_number")
  supplierCreditNoteDate   DateTime?                 @map("supplier_credit_note_date")
  gstTaxableAmount         Decimal?                  @map("gst_taxable_amount") @db.Decimal(15, 2)
  gstCgstAmount            Decimal?                  @map("gst_cgst_amount") @db.Decimal(15, 2)
  gstSgstAmount            Decimal?                  @map("gst_sgst_amount") @db.Decimal(15, 2)
  gstIgstAmount            Decimal?                  @map("gst_igst_amount") @db.Decimal(15, 2)
  gstCessAmount            Decimal?                  @map("gst_cess_amount") @db.Decimal(15, 2)
  gstSupportingReference   String?                   @map("gst_supporting_reference")
  gstNotes                 String?                   @map("gst_notes")
  basicAmount              Decimal                   @default(0.00) @map("basic_amount") @db.Decimal(15, 2)
  taxableValue             Decimal                   @default(0.00) @map("taxable_value") @db.Decimal(15, 2)
  cgstRate                 Decimal                   @default(0.00) @map("cgst_rate") @db.Decimal(5, 2)
  cgstAmount               Decimal                   @default(0.00) @map("cgst_amount") @db.Decimal(15, 2)
  sgstRate                 Decimal                   @default(0.00) @map("sgst_rate") @db.Decimal(5, 2)
  sgstAmount               Decimal                   @default(0.00) @map("sgst_amount") @db.Decimal(15, 2)
  igstRate                 Decimal                   @default(0.00) @map("igst_rate") @db.Decimal(5, 2)
  igstAmount               Decimal                   @default(0.00) @map("igst_amount") @db.Decimal(15, 2)
  tcsAmount                Decimal                   @default(0.00) @map("tcs_amount") @db.Decimal(15, 2)
  roundOff                 Decimal                   @default(0.00) @map("round_off") @db.Decimal(10, 2)
  totalAmount              Decimal                   @default(0.00) @map("total_amount") @db.Decimal(15, 2)
  status                   DebitNoteStatus           @default(CONFIRMED)
  cancellationReason       String?                   @map("cancellation_reason")
  cancelledAt              DateTime?                 @map("cancelled_at")
  createdAt                DateTime                  @default(now()) @map("created_at")
  updatedAt                DateTime                  @updatedAt @map("updated_at")

  company       Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  financialYear FinancialYear       @relation(fields: [companyId, financialYearId], references: [companyId, id], onDelete: Restrict)
  book          DebitNoteBook       @relation(fields: [bookId], references: [id], onDelete: Restrict)
  party         Party               @relation(fields: [companyId, partyId], references: [companyId, id], onDelete: Restrict)
  broker        Broker?             @relation(fields: [companyId, brokerId], references: [companyId, id], onDelete: Restrict)
  transporter   Transporter?        @relation(fields: [companyId, transporterId], references: [companyId, id], onDelete: Restrict)
  salesperson   Salesperson?        @relation(fields: [companyId, salespersonId], references: [companyId, id], onDelete: Restrict)
  creditAccount LedgerAccount       @relation("DebitNoteCreditAccount", fields: [companyId, creditAccountId], references: [companyId, id], onDelete: Restrict)
  purchaseBill  PurchaseBill?       @relation(fields: [purchaseBillId], references: [id], onDelete: Restrict)
  billLines     DebitNoteBillLine[]
  itemLines     DebitNoteLine[]
  journalLines  JournalLine[]

  @@unique([companyId, financialYearId, bookId, voucherNumber])
  @@unique([companyId, financialYearId, noteNumber])
  @@index([companyId, financialYearId, noteDate])
  @@index([companyId, partyId])
  @@index([companyId, bookId])
  @@index([companyId, purchaseBillId])
  @@map("debit_notes")
}

model DebitNoteBillLine {
  id              String    @id @default(uuid())
  debitNoteId     String    @map("debit_note_id")
  lineNumber      Int       @map("line_number")
  billNo          String    @map("bill_no")
  billDate        DateTime  @map("bill_date")
  totalDays       Int       @default(0) @map("total_days")
  dharaDays       Int       @default(0) @map("dhara_days")
  interestDays    Int       @default(0) @map("interest_days")
  paidAmount      Decimal   @default(0.00) @map("paid_amount") @db.Decimal(15, 2)
  paidDate        DateTime? @map("paid_date")
  itemDescription String?   @map("item_description")
  quantity        Decimal   @default(0.000) @db.Decimal(12, 3)
  billTaxable     Decimal   @default(0.00) @map("bill_taxable") @db.Decimal(15, 2)
  billAmount      Decimal   @default(0.00) @map("bill_amount") @db.Decimal(15, 2)
  unpaidAmount    Decimal   @default(0.00) @map("unpaid_amount") @db.Decimal(15, 2)
  sgstRate        Decimal   @default(0.00) @map("sgst_rate") @db.Decimal(5, 2)
  cgstRate        Decimal   @default(0.00) @map("cgst_rate") @db.Decimal(5, 2)
  igstRate        Decimal   @default(0.00) @map("igst_rate") @db.Decimal(5, 2)
  rate            Decimal   @default(0.00) @db.Decimal(15, 4)
  basicAmount     Decimal   @default(0.00) @map("basic_amount") @db.Decimal(15, 2)
  sourceBillId    String?   @map("source_bill_id")
  sourceBillType  String?   @map("source_bill_type")

  debitNote DebitNote @relation(fields: [debitNoteId], references: [id], onDelete: Cascade)

  @@unique([debitNoteId, lineNumber])
  @@index([debitNoteId])
  @@map("debit_note_bill_lines")
}

// ---------------------------------------------------------------------------
// Phase 14 - Purchase Return / Adjustment Debit Note lines
// ---------------------------------------------------------------------------

model DebitNoteLine {
  id                         String    @id @default(uuid())
  companyId                  String    @map("company_id")
  debitNoteId                String    @map("debit_note_id")
  lineNumber                 Int       @map("line_number")
  purchaseBillItemId         String?   @map("purchase_bill_item_id")
  itemId                     String?   @map("item_id")
  itemCode                   String?   @map("item_code")
  itemName                   String    @map("item_name")
  yarnQuality                String?   @map("yarn_quality")
  yarnCount                  String?   @map("yarn_count")
  yarnGrade                  String?   @map("yarn_grade")
  lotNumber                  String?   @map("lot_number")
  originalQuantity           Decimal   @default(0.000) @map("original_quantity") @db.Decimal(15, 3)
  previouslyAdjustedQuantity Decimal   @default(0.000) @map("previously_adjusted_quantity") @db.Decimal(15, 3)
  acceptedQuantity           Decimal   @default(0.000) @map("accepted_quantity") @db.Decimal(15, 3)
  currentQuantity            Decimal   @default(0.000) @map("current_quantity") @db.Decimal(15, 3)
  unit                       String    @default("KG")
  originalRate               Decimal   @default(0.0000) @map("original_rate") @db.Decimal(15, 4)
  revisedRate                Decimal?  @map("revised_rate") @db.Decimal(15, 4)
  rateDifference             Decimal?  @map("rate_difference") @db.Decimal(15, 4)
  taxableAmount              Decimal   @default(0.00) @map("taxable_amount") @db.Decimal(15, 2)
  gstRate                    Decimal   @default(0.00) @map("gst_rate") @db.Decimal(5, 2)
  cgstAmount                 Decimal   @default(0.00) @map("cgst_amount") @db.Decimal(15, 2)
  sgstAmount                 Decimal   @default(0.00) @map("sgst_amount") @db.Decimal(15, 2)
  igstAmount                 Decimal   @default(0.00) @map("igst_amount") @db.Decimal(15, 2)
  lineTotal                  Decimal   @default(0.00) @map("line_total") @db.Decimal(15, 2)
  weighbridgeSlipNumber      String?   @map("weighbridge_slip_number")
  weighmentDate              DateTime? @map("weighment_date")
  inspectionReference        String?   @map("inspection_reference")
  supportingReference        String?   @map("supporting_reference")
  lineReason                 String?   @map("line_reason")
  remarks                    String?
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  debitNote        DebitNote         @relation(fields: [debitNoteId], references: [id], onDelete: Cascade)
  purchaseBillItem PurchaseBillItem? @relation(fields: [purchaseBillItemId], references: [id], onDelete: Restrict)
  item             Item?             @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@unique([debitNoteId, lineNumber])
  @@index([debitNoteId])
  @@index([companyId, purchaseBillItemId])
  @@map("debit_note_lines")
}

// ---------------------------------------------------------------------------
// Phase 15.1 - Persistent report column layouts (company scoped).
// No user identity infrastructure exists yet, so layouts are scoped to a
// company + report type. createdBy is an optional free-text reference.
// ---------------------------------------------------------------------------

model ReportColumnLayout {
  id              String   @id @default(uuid())
  companyId       String   @map("company_id")
  reportType      String   @default("BILL_BASE") @map("report_type")
  layoutName      String   @map("layout_name")
  selectedColumns Json     @map("selected_columns")
  columnOrder     Json     @map("column_order")
  isDefault       Boolean  @default(false) @map("is_default")
  createdBy       String?  @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, reportType, layoutName])
  @@index([companyId, reportType])
  @@map("report_column_layouts")
}

// ---------------------------------------------------------------------------
// Phase 16 - Bank Reconciliation
// Reconciliation is metadata only: it never creates journal entries and never
// changes a ledger balance. Clearing dates are stored against the real
// bank-side JournalLine that an existing voucher already produced.
// ---------------------------------------------------------------------------

enum BankReconciliationAction {
  SET_CLEARING_DATE
  REMOVE_CLEARING_DATE
  OPENING_BALANCE_SET
  OPENING_BALANCE_ACKNOWLEDGED
  STATEMENT_SAVED
}

enum BankReconciliationStatus {
  DRAFT
  BALANCED
  UNBALANCED
}

model BankReconciliationOpening {
  id                      String    @id @default(uuid())
  companyId               String    @map("company_id")
  financialYearId         String    @map("financial_year_id")
  bankLedgerAccountId     String    @map("bank_ledger_account_id")
  openingDate             DateTime  @map("opening_date")
  openingStatementBalance Decimal   @map("opening_statement_balance") @db.Decimal(15, 2)
  openingBookBalance      Decimal   @map("opening_book_balance") @db.Decimal(15, 2)
  difference              Decimal   @default(0.00) @db.Decimal(15, 2)
  isAcknowledged          Boolean   @default(false) @map("is_acknowledged")
  acknowledgedAt          DateTime? @map("acknowledged_at")
  createdBy               String?   @map("created_by")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  company           Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  financialYear     FinancialYear @relation(fields: [companyId, financialYearId], references: [companyId, id], onDelete: Restrict)
  bankLedgerAccount LedgerAccount @relation("BankReconciliationOpeningLedger", fields: [companyId, bankLedgerAccountId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, financialYearId, bankLedgerAccountId])
  @@index([companyId, bankLedgerAccountId])
  @@map("bank_reconciliation_openings")
}

model BankReconciliationMark {
  id                  String   @id @default(uuid())
  companyId           String   @map("company_id")
  financialYearId     String   @map("financial_year_id")
  bankLedgerAccountId String   @map("bank_ledger_account_id")
  bankJournalLineId   String   @map("bank_journal_line_id")
  clearingDate        DateTime @map("clearing_date")
  createdBy           String?  @map("created_by")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  company           Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  financialYear     FinancialYear             @relation(fields: [companyId, financialYearId], references: [companyId, id], onDelete: Restrict)
  bankLedgerAccount LedgerAccount             @relation("BankReconciliationMarkLedger", fields: [companyId, bankLedgerAccountId], references: [companyId, id], onDelete: Restrict)
  bankJournalLine   JournalLine               @relation("BankReconciliationMarkLine", fields: [companyId, bankJournalLineId], references: [companyId, id], onDelete: Cascade)
  audits            BankReconciliationAudit[]

  @@unique([companyId, bankJournalLineId])
  @@index([companyId, financialYearId, bankLedgerAccountId])
  @@map("bank_reconciliation_marks")
}

model BankReconciliationAudit {
  id                   String                   @id @default(uuid())
  companyId            String                   @map("company_id")
  financialYearId      String                   @map("financial_year_id")
  bankLedgerAccountId  String                   @map("bank_ledger_account_id")
  reconciliationMarkId String?                  @map("reconciliation_mark_id")
  bankJournalLineId    String?                  @map("bank_journal_line_id")
  action               BankReconciliationAction
  previousClearingDate DateTime?                @map("previous_clearing_date")
  newClearingDate      DateTime?                @map("new_clearing_date")
  changedBy            String?                  @map("changed_by")
  reason               String?
  changedAt            DateTime                 @default(now()) @map("changed_at")

  company            Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  financialYear      FinancialYear           @relation(fields: [companyId, financialYearId], references: [companyId, id], onDelete: Restrict)
  bankLedgerAccount  LedgerAccount           @relation("BankReconciliationAuditLedger", fields: [companyId, bankLedgerAccountId], references: [companyId, id], onDelete: Restrict)
  reconciliationMark BankReconciliationMark? @relation(fields: [reconciliationMarkId], references: [id], onDelete: SetNull)

  @@index([companyId, financialYearId, bankLedgerAccountId, changedAt])
  @@index([companyId, bankJournalLineId])
  @@map("bank_reconciliation_audits")
}

model BankReconciliationStatement {
  id                      String                   @id @default(uuid())
  companyId               String                   @map("company_id")
  financialYearId         String                   @map("financial_year_id")
  bankLedgerAccountId     String                   @map("bank_ledger_account_id")
  fromDate                DateTime                 @map("from_date")
  toDate                  DateTime                 @map("to_date")
  openingStatementBalance Decimal                  @map("opening_statement_balance") @db.Decimal(15, 2)
  closingStatementBalance Decimal                  @map("closing_statement_balance") @db.Decimal(15, 2)
  bookOpeningBalance      Decimal                  @map("book_opening_balance") @db.Decimal(15, 2)
  bookClosingBalance      Decimal                  @map("book_closing_balance") @db.Decimal(15, 2)
  unclearedPayments       Decimal                  @map("uncleared_payments") @db.Decimal(15, 2)
  unclearedReceipts       Decimal                  @map("uncleared_receipts") @db.Decimal(15, 2)
  calculatedBankBalance   Decimal                  @map("calculated_bank_balance") @db.Decimal(15, 2)
  difference              Decimal                  @default(0.00) @db.Decimal(15, 2)
  status                  BankReconciliationStatus @default(DRAFT)
  createdBy               String?                  @map("created_by")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")

  company           Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  financialYear     FinancialYear @relation(fields: [companyId, financialYearId], references: [companyId, id], onDelete: Restrict)
  bankLedgerAccount LedgerAccount @relation("BankReconciliationStatementLedger", fields: [companyId, bankLedgerAccountId], references: [companyId, id], onDelete: Restrict)

  @@index([companyId, financialYearId, bankLedgerAccountId, toDate])
  @@map("bank_reconciliation_statements")
}
