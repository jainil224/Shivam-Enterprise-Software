datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model Company {
  id          String   @id @default(uuid())
  companyCode String   @unique @map("company_code")
  companyName String   @map("company_name")
  gstin       String?
  panNumber   String?  @map("pan_number")
  address     String?
  city        String?
  state       String?
  pincode     String?
  phone       String?
  email       String?
  logoPath    String?  @map("logo_path")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  financialYears               FinancialYear[]
  ledgerAccounts               LedgerAccount[]
  bankVouchers                 BankVoucher[]
  journalLines                 JournalLine[]
  voucherSequences             VoucherSequence[]
  parties                      Party[]
  machines                     Machine[]
  operators                    Operator[]
  locations                    Location[]
  yarnQualities                YarnQuality[]
  yarnGrades                   YarnGrade[]
  productionBooks              ProductionBook[]
  productionReceives           ProductionReceive[]
  purchaseBills                PurchaseBill[]
  debitNoteBooks               DebitNoteBook[]
  debitNotes                   DebitNote[]
  reportColumnLayouts          ReportColumnLayout[]
  bankReconciliationOpenings   BankReconciliationOpening[]
  bankReconciliationMarks      BankReconciliationMark[]
  bankReconciliationAudits     BankReconciliationAudit[]
  bankReconciliationStatements BankReconciliationStatement[]
  partyGroups                  PartyGroup[]
  areas                        Area[]
  brokers                      Broker[]
  transporters                 Transporter[]
  salespersons                 Salesperson[]
  itemGroups                   ItemGroup[]
  purchaseBooks                PurchaseBook[]

  items                Item[]
  salesOrders          SalesOrder[]
  purchaseOrders       PurchaseOrder[]
  orderStatusHistory   OrderStatusHistory[]
  orderFulfilmentLinks OrderFulfilmentLink[]
  orderSequences       OrderSequence[]

  @@map("companies")
}

model FinancialYear {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  yearName  String   @map("year_name")
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  isActive  Boolean  @default(true) @map("is_active")
  isLocked  Boolean  @default(false) @map("is_locked")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productionBooks    ProductionBook[]
  productionReceives ProductionReceive[]
  purchaseBills      PurchaseBill[]
  bankVouchers       BankVoucher[]
  journalLines       JournalLine[]
  voucherSequences   VoucherSequence[]
  debitNoteBooks     DebitNoteBook[]
  debitNotes         DebitNote[]
  purchaseBooks      PurchaseBook[]

  salesOrders                  SalesOrder[]
  purchaseOrders               PurchaseOrder[]
  orderStatusHistory           OrderStatusHistory[]
  orderFulfilmentLinks         OrderFulfilmentLink[]
  orderSequences               OrderSequence[]
  bankReconciliationOpenings   BankReconciliationOpening[]
  bankReconciliationMarks      BankReconciliationMark[]
  bankReconciliationAudits     BankReconciliationAudit[]
  bankReconciliationStatements BankReconciliationStatement[]

  @@unique([companyId, id])
  @@unique([companyId, yearName])
  @@index([companyId, isActive])
  @@index([companyId, startDate, endDate])
  @@map("financial_years")
}

enum PartyType {
  CUSTOMER
  SUPPLIER
  BOTH
}

enum BalanceType {
  DEBIT
  CREDIT
}

model Party {
  id             String      @id @default(uuid())
  companyId      String      @map("company_id")
  partyName      String      @map("party_name")
  partyCode      String      @map("party_code")
  partyType      PartyType   @default(CUSTOMER) @map("party_type")
  gstin          String?
  panNumber      String?     @map("pan_number")
  address        String?
  city           String?
  state          String?
  pincode        String?
  phone          String?
  email          String?
  openingBalance Decimal     @default(0.00) @map("opening_balance") @db.Decimal(15, 2)
  balanceType    BalanceType @default(DEBIT) @map("balance_type")
  partyGroupId   String?     @map("party_group_id")
  areaId         String?     @map("area_id")
  isActive       Boolean     @default(true) @map("is_active")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  company               Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  partyGroup            PartyGroup?         @relation(fields: [companyId, partyGroupId], references: [companyId, id], onDelete: Restrict)
  area                  Area?               @relation(fields: [companyId, areaId], references: [companyId, id], onDelete: Restrict)
  productionReceives    ProductionReceive[]
  ledgerAccounts        LedgerAccount[]
  bankVouchers          BankVoucher[]
  purchaseBills         PurchaseBill[]      @relation("PurchaseBillParty")
  deliveryPurchaseBills PurchaseBill[]      @relation("PurchaseBillDeliveryParty")
  debitNotes            DebitNote[]
  salesOrders           SalesOrder[]
  purchaseOrders        PurchaseOrder[]

  @@unique([companyId, id])
  @@unique([companyId, partyCode])
  @@index([companyId, partyType])
  @@index([companyId, partyName])
  @@map("parties")
}

// =============================================================
// Phase 15.2 - Report master data (company scoped)
// =============================================================

model PartyGroup {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  groupName   String   @map("group_name")
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parties Party[]

  @@unique([companyId, id])
  @@unique([companyId, groupName])
  @@index([companyId, isActive])
  @@map("party_groups")
}

model Area {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  areaName    String   @map("area_name")
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parties Party[]

  @@unique([companyId, id])
  @@unique([companyId, areaName])
  @@index([companyId, isActive])
  @@map("areas")
}

model Broker {
  id         String   @id @default(uuid())
  companyId  String   @map("company_id")
  brokerCode String   @map("broker_code")
  brokerName String   @map("broker_name")
  phone      String?
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchaseBills PurchaseBill[]
  debitNotes    DebitNote[]

  @@unique([companyId, id])
  @@unique([companyId, brokerCode])
  @@index([companyId, isActive])
  @@map("brokers")
}

model Transporter {
  id              String   @id @default(uuid())
  companyId       String   @map("company_id")
  transporterCode String   @map("transporter_code")
  transporterName String   @map("transporter_name")
  phone           String?
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchaseBills PurchaseBill[]
  debitNotes    DebitNote[]

  @@unique([companyId, id])
  @@unique([companyId, transporterCode])
  @@index([companyId, isActive])
  @@map("transporters")
}

model Salesperson {
  id              String   @id @default(uuid())
  companyId       String   @map("company_id")
  salespersonCode String   @map("salesperson_code")
  salespersonName String   @map("salesperson_name")
  phone           String?
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchaseBills PurchaseBill[]
  debitNotes    DebitNote[]

  @@unique([companyId, id])
  @@unique([companyId, salespersonCode])
  @@index([companyId, isActive])
  @@map("salespersons")
}

model ItemGroup {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  groupName   String   @map("group_name")
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   Item[]

  @@unique([companyId, id])
  @@unique([companyId, groupName])
  @@index([companyId, isActive])
  @@map("item_groups")
}

model PurchaseBook {
  id              String   @id @default(uuid())
  companyId       String   @map("company_id")
  financialYearId String   @map("financial_year_id")
  prefix          String
  bookName        String   @map("book_name")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  financialYear FinancialYear  @relation(fields: [companyId, financialYearId], references: [companyId, id], onDelete: Cascade)
  purchaseBills PurchaseBill[]

  @@unique([companyId, id])
  @@unique([companyId, financialYearId, id])
  @@unique([companyId, financialYearId, bookName])
  @@unique([companyId, financialYearId, prefix])
  @@index([companyId, financialYearId, isActive])
  @@map("purchase_books")
}

model Machine {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  machineCode String   @map("machine_code")
  machineName String   @map("machine_name")
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productionReceives ProductionReceive[]

  @@unique([companyId, id])
  @@unique([companyId, machineCode])
  @@map("machines")
}

model Operator {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  operatorCode String   @map("operator_code")
  operatorName String   @map("operator_name")
  phone        String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productionReceives ProductionReceive[]

  @@unique([companyId, id])
  @@unique([companyId, operatorCode])
  @@map("operators")
}

model Location {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  locationName String   @map("location_name")
  description  String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productionReceives ProductionReceive[]
  purchaseOrders     PurchaseOrder[]
  purchaseOrderLines PurchaseOrderLine[]

  @@unique([companyId, id])
  @@unique([companyId, locationName])
  @@map("locations")
}

model YarnQuality {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  qualityName String   @map("quality_name")
  denier      String?
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productionReceives ProductionReceive[]
  items              Item[]
  purchaseBillItems  PurchaseBillItem[]

  @@unique([companyId, id])
  @@unique([companyId, qualityName])
  @@map("yarn_qualities")
}

model YarnGrade {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  gradeName   String   @map("grade_name")
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productionReceives ProductionReceive[]
  items              Item[]
  purchaseBillItems  PurchaseBillItem[]

  @@unique([companyId, id])
  @@unique([companyId, gradeName])
  @@map("yarn_grades")
}

model ProductionBook {
  id              String   @id @default(uuid())
  companyId       String   @map("company_id")
  financialYearId String   @map("financial_year_id")
  prefix          String
  bookName        String   @map("book_name")
  openingBalance  Decimal  @default(0.000) @map("opening_balance") @db.Decimal(15, 3)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  financialYear      FinancialYear       @relation(fields: [companyId, financialYearId], references: [companyId, id], onDelete: Cascade)
  productionReceives ProductionReceive[]

  @@unique([companyId, id])
  @@unique([companyId, financialYearId, id])
  @@unique([companyId, financialYearId, bookName])
  @@unique([companyId, financialYearId, prefix])
  @@map("production_books")
}

enum ProductionReceiveStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

model ProductionReceive {
  id                 String                  @id @default(uuid())
  companyId          String                  @map("company_id")
  financialYearId    String                  @map("financial_year_id")
  productionBookId   String                  @map("production_book_id")
  challanNumber      String                  @map("challan_number")
  challanDate        DateTime                @map("challan_date")
  partyId            String?                 @map("party_id")
  machineId          String?                 @map("machine_id")
  operatorId         String?                 @map("operator_id")
  yarnQualityId      String?                 @map("yarn_quality_id")
  yarnGradeId        String?                 @map("yarn_grade_id")
  lotNumber          String?                 @map("lot_number")
  twist              String?
  emptyCopsWeight    Decimal                 @default(0.000) @map("empty_cops_weight") @db.Decimal(10, 3)
  locationId         String?                 @map("location_id")
  remarks            String?
  status             ProductionReceiveStatus @default(DRAFT)
  cancellationReason String?                 @map("cancellation_reason")
  cancelledAt        DateTime?               @map("cancelled_at")
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")

  company        Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  financialYear  FinancialYear           @relation(fields: [companyId, financialYearId], references: [companyId, id], onDelete: Restrict)
  productionBook ProductionBook          @relation(fields: [companyId, financialYearId, productionBookId], references: [companyId, financialYearId, id], onDelete: Restrict)
  party          Party?                  @relation(fields: [companyId, partyId], references: [companyId, id], onDelete: Restrict)
  machine        Machine?                @relation(fields: [companyId, machineId], references: [companyId, id], onDelete: Restrict)
  operator       Operator?               @relation(fields: [companyId, operatorId], references: [companyId, id], onDelete: Restrict)
  yarnQuality    YarnQuality?            @relation(fields: [companyId, yarnQualityId], references: [companyId, id], onDelete: Restrict)
  yarnGrade      YarnGrade?              @relation(fields: [companyId, yarnGradeId], references: [companyId, id], onDelete: Restrict)
  location       Location?               @relation(fields: [companyId, locationId], references: [companyId, id], onDelete: Restrict)
  items          ProductionReceiveItem[]
  purchaseBill   PurchaseBill?           @relation("ChallanToPurchaseBill")

  @@unique([companyId, financialYearId, productionBookId, challanNumber])
  @@index([companyId, financialYearId, challanDate])
  @@index([companyId, partyId])
  @@map("production_receives")
}

model ProductionReceiveItem {
  id                  String   @id @default(uuid())
  productionReceiveId String   @map("production_receive_id")
  cartonNumber        String   @map("carton_number")
  cartonWeight        Decimal  @map("carton_weight") @db.Decimal(10, 3)
  cops                Int
  grossWeight         Decimal  @map("gross_weight") @db.Decimal(10, 3)
  copsWeight          Decimal  @map("cops_weight") @db.Decimal(10, 3)
  tareWeight          Decimal  @map("tare_weight") @db.Decimal(10, 3)
  netWeight           Decimal  @map("net_weight") @db.Decimal(10, 3)
  twist               String?
  lotNumber           String?  @map("lot_number")
  grade               String?
  averageWeight       Decimal  @map("average_weight") @db.Decimal(10, 3)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  productionReceive ProductionReceive @relation(fields: [productionReceiveId], references: [id], onDelete: Cascade)

  @@unique([productionReceiveId, cartonNumber])
  @@index([productionReceiveId])
  @@map("production_receive_items")
}

enum PurchaseBillStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

model PurchaseBill {
  id                    String             @id @default(uuid())
  companyId             String             @map("company_id")
  financialYearId       String             @map("financial_year_id")
  billNumber            String             @map("bill_number")
  billDate              DateTime           @map("bill_date")
  sourceChallanId       String?            @unique @map("source_challan_id")
  partyId               String?            @map("party_id")
  bookId                String?            @map("book_id")
  brokerId              String?            @map("broker_id")
  transporterId         String?            @map("transporter_id")
  salespersonId         String?            @map("salesperson_id")
  deliveryPartyId       String?            @map("delivery_party_id")
  vehicleNumber         String?            @map("vehicle_number")
  supplierGstin         String?            @map("supplier_gstin")
  supplierLegalName     String             @map("supplier_legal_name")
  supplierTradeName     String?            @map("supplier_trade_name")
  supplierAddress       String?            @map("supplier_address")
  supplierState         String?            @map("supplier_state")
  supplierStateCode     String?            @map("supplier_state_code")
  supplierPincode       String?            @map("supplier_pincode")
  supplierCity          String?            @map("supplier_city")
  verificationSource    String             @default("MANUAL_UNVERIFIED") @map("verification_source")
  verificationTimestamp DateTime?          @map("verification_timestamp")
  isVerifiedSupplier    Boolean            @default(false) @map("is_verified_supplier")
  supplierInvoiceNumber String?            @map("supplier_invoice_number")
  supplierInvoiceDate   DateTime?          @map("supplier_invoice_date")
  placeOfSupply         String?            @map("place_of_supply")
  totalQuantity         Decimal            @default(0.000) @map("total_quantity") @db.Decimal(12, 3)
  taxableAmount         Decimal            @default(0.00) @map("taxable_amount") @db.Decimal(15, 2)
  cgstRate              Decimal            @default(0.00) @map("cgst_rate") @db.Decimal(5, 2)
  cgstAmount            Decimal            @default(0.00) @map("cgst_amount") @db.Decimal(15, 2)
  sgstRate              Decimal            @default(0.00) @map("sgst_rate") @db.Decimal(5, 2)
  sgstAmount            Decimal            @default(0.00) @map("sgst_amount") @db.Decimal(15, 2)
  igstRate              Decimal            @default(0.00) @map("igst_rate") @db.Decimal(5, 2)
  igstAmount            Decimal            @default(0.00) @map("igst_amount") @db.Decimal(15, 2)
  roundOff              Decimal            @default(0.00) @map("round_off") @db.Decimal(10, 2)
  totalAmount           Decimal            @default(0.00) @map("total_amount") @db.Decimal(15, 2)
  status                PurchaseBillStatus @default(CONFIRMED)
  remarks               String?
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  company              Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  financialYear        FinancialYear      @relation(fields: [companyId, financialYearId], references: [companyId, id], onDelete: Restrict)
  party                Party?             @relation("PurchaseBillParty", fields: [companyId, partyId], references: [companyId, id], onDelete: Restrict)
  deliveryParty        Party?             @relation("PurchaseBillDeliveryParty", fields: [companyId, deliveryPartyId], references: [companyId, id], onDelete: Restrict)
  book                 PurchaseBook?      @relation(fields: [companyId, financialYearId, bookId], references: [companyId, financialYearId, id], onDelete: Restrict)
  broker               Broker?            @relation(fields: [companyId, brokerId], references: [companyId, id], onDelete: Restrict)
  transporter          Transporter?       @relation(fields: [companyId, transporterId], references: [companyId, id], onDelete: Restrict)
  salesperson          Salesperson?       @relation(fields: [companyId, salespersonId], references: [companyId, id], onDelete: Restrict)
  sourceChallan        ProductionReceive? @relation("ChallanToPurchaseBill", fields: [sourceChallanId], references: [id], onDelete: Restrict)
  items                PurchaseBillItem[]
  debitNoteAdjustments DebitNote[]

  @@unique([companyId, financialYearId, billNumber])
  @@index([companyId, financialYearId, billDate])
  @@index([companyId, supplierGstin])
  @@map("purchase_bills")
}

model PurchaseBillItem {
  id              String   @id @default(uuid())
  purchaseBillId  String   @map("purchase_bill_id")
  itemId          String?  @map("item_id")
  itemDescription String   @map("item_description")
  hsnCode         String?  @map("hsn_code")
  quantity        Decimal  @db.Decimal(12, 3)
  unit            String   @default("KG")
  rate            Decimal  @db.Decimal(15, 2)
  discount        Decimal  @default(0.00) @db.Decimal(15, 2)
  taxableAmount   Decimal  @map("taxable_amount") @db.Decimal(15, 2)
  cartonNumber    String?  @map("carton_number")
  lotNumber       String?  @map("lot_number")
  grade           String?
  yarnQualityId   String?  @map("yarn_quality_id")
  yarnGradeId     String?  @map("yarn_grade_id")
  cops            Int?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  purchaseBill   PurchaseBill    @relation(fields: [purchaseBillId], references: [id], onDelete: Cascade)
  item           Item?           @relation(fields: [itemId], references: [id], onDelete: Restrict)
  yarnQuality    YarnQuality?    @relation(fields: [yarnQualityId], references: [id], onDelete: Restrict)
  yarnGrade      YarnGrade?      @relation(fields: [yarnGradeId], references: [id], onDelete: Restrict)
  debitNoteLines DebitNoteLine[]

  @@index([purchaseBillId])
  @@map("purchase_bill_items")
}

// =============================================================
// Phase 12 â€” Ledger Accounts & Bank Vouchers (Bank Receipt / Payment)
// =============================================================

enum LedgerAccountGroup {
  BANK
  SUNDRY_DEBTORS
  SUNDRY_CREDITORS
  DIRECT_EXPENSES
  INDIRECT_EXPENSES
  DIRECT_INCOME
  INDIRECT_INCOME
  ASSETS
  LIABILITIES
  CAPITAL
  OTHERS
}

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum BankVoucherType {
  RECEIPT
  PAYMENT
}

enum PaymentMode {
  NEFT
  RTGS
  IMPS
  CHEQUE
  UPI
  BANK_TRANSFER
  OTHER
}

enum BankVoucherStatus {
  POSTED
  CANCELLED
}

model LedgerAccount {
  id                String             @id @default(uuid())
  companyId         String             @map("company_id")
  accountCode       String             @map("account_code")
  accountName       String             @map("account_name")
  accountGroup      LedgerAccountGroup @map("account_group")
  accountType       LedgerAccountType  @map("account_type")
  balanceType       BalanceType        @default(DEBIT) @map("balance_type")
  openingBalance    Decimal            @default(0.00) @map("opening_balance") @db.Decimal(15, 2)
  isBankAccount     Boolean            @default(false) @map("is_bank_account")
  bankName          String?            @map("bank_name")
  branchName        String?            @map("branch_name")
  accountHolderName String?            @map("account_holder_name")
  ifscCode          String?            @map("ifsc_code")
  bankAccountNumber String?            @map("bank_account_number")
  partyId           String?            @map("party_id")
  isAutoCreated     Boolean            @default(false) @map("is_auto_created")
  description       String?
  isActive          Boolean            @default(true) @map("is_active")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  company                      Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  party                        Party?                        @relation(fields: [companyId, partyId], references: [companyId, id], onDelete: Restrict)
  journalLines                 JournalLine[]
  bankAccountVouchers          BankVoucher[]                 @relation("BankAccountVoucher")
  counterpartyVouchers         BankVoucher[]                 @relation("CounterpartyVoucher")
  debitNotesCreditAccount      DebitNote[]                   @relation("DebitNoteCreditAccount")
