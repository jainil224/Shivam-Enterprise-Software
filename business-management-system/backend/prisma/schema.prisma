datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model Company {
  id          String   @id @default(uuid())
  companyCode String   @unique @map("company_code")
  companyName String   @map("company_name")
  gstin       String?
  panNumber   String?  @map("pan_number")
  address     String?
  city        String?
  state       String?
  pincode     String?
  phone       String?
  email       String?
  logoPath    String?  @map("logo_path")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  financialYears     FinancialYear[]
  ledgerAccounts     LedgerAccount[]
  bankVouchers       BankVoucher[]
  journalLines       JournalLine[]
  voucherSequences   VoucherSequence[]
  parties            Party[]
  machines           Machine[]
  operators          Operator[]
  locations          Location[]
  yarnQualities      YarnQuality[]
  yarnGrades         YarnGrade[]
  productionBooks    ProductionBook[]
  productionReceives ProductionReceive[]
  purchaseBills      PurchaseBill[]

  items                 Item[]
  salesOrders           SalesOrder[]
  purchaseOrders        PurchaseOrder[]
  orderStatusHistory    OrderStatusHistory[]
  orderFulfilmentLinks  OrderFulfilmentLink[]
  orderSequences        OrderSequence[]

  @@map("companies")
}

model FinancialYear {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  yearName  String   @map("year_name")
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  isActive  Boolean  @default(true) @map("is_active")
  isLocked  Boolean  @default(false) @map("is_locked")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productionBooks    ProductionBook[]
  productionReceives ProductionReceive[]
  purchaseBills      PurchaseBill[]
  bankVouchers       BankVoucher[]
  journalLines       JournalLine[]
  voucherSequences   VoucherSequence[]

  salesOrders           SalesOrder[]
  purchaseOrders        PurchaseOrder[]
  orderStatusHistory    OrderStatusHistory[]
  orderFulfilmentLinks  OrderFulfilmentLink[]
  orderSequences        OrderSequence[]

  @@unique([companyId, id])
  @@unique([companyId, yearName])
  @@index([companyId, isActive])
  @@index([companyId, startDate, endDate])
  @@map("financial_years")
}

enum PartyType {
  CUSTOMER
  SUPPLIER
  BOTH
}

enum BalanceType {
  DEBIT
  CREDIT
}

model Party {
  id             String      @id @default(uuid())
  companyId      String      @map("company_id")
  partyName      String      @map("party_name")
  partyCode      String      @map("party_code")
  partyType      PartyType   @default(CUSTOMER) @map("party_type")
  gstin          String?
  panNumber      String?     @map("pan_number")
  address        String?
  city           String?
  state          String?
  pincode        String?
  phone          String?
  email          String?
  openingBalance Decimal     @default(0.00) @db.Decimal(15, 2) @map("opening_balance")
  balanceType    BalanceType @default(DEBIT) @map("balance_type")
  isActive       Boolean     @default(true) @map("is_active")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productionReceives ProductionReceive[]
  ledgerAccounts     LedgerAccount[]
  bankVouchers       BankVoucher[]
  purchaseBills      PurchaseBill[]
  salesOrders        SalesOrder[]
  purchaseOrders     PurchaseOrder[]

  @@unique([companyId, id])
  @@unique([companyId, partyCode])
  @@index([companyId, partyType])
  @@index([companyId, partyName])
  @@map("parties")
}

model Machine {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  machineCode String   @map("machine_code")
  machineName String   @map("machine_name")
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productionReceives ProductionReceive[]

  @@unique([companyId, id])
  @@unique([companyId, machineCode])
  @@map("machines")
}

model Operator {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  operatorCode String   @map("operator_code")
  operatorName String   @map("operator_name")
  phone        String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productionReceives ProductionReceive[]

  @@unique([companyId, id])
  @@unique([companyId, operatorCode])
  @@map("operators")
}

model Location {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  locationName String   @map("location_name")
  description  String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productionReceives ProductionReceive[]
  purchaseOrders     PurchaseOrder[]
  purchaseOrderLines PurchaseOrderLine[]

  @@unique([companyId, id])
  @@unique([companyId, locationName])
  @@map("locations")
}

model YarnQuality {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  qualityName String   @map("quality_name")
  denier      String?
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productionReceives ProductionReceive[]
  items              Item[]

  @@unique([companyId, id])
  @@unique([companyId, qualityName])
  @@map("yarn_qualities")
}

model YarnGrade {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  gradeName   String   @map("grade_name")
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productionReceives ProductionReceive[]
  items              Item[]

  @@unique([companyId, id])
  @@unique([companyId, gradeName])
  @@map("yarn_grades")
}

model ProductionBook {
  id              String   @id @default(uuid())
  companyId       String   @map("company_id")
  financialYearId String   @map("financial_year_id")
  prefix          String
  bookName        String   @map("book_name")
  openingBalance  Decimal  @default(0.000) @db.Decimal(15, 3) @map("opening_balance")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  financialYear      FinancialYear       @relation(fields: [companyId, financialYearId], references: [companyId, id], onDelete: Cascade)
  productionReceives ProductionReceive[]

  @@unique([companyId, id])
  @@unique([companyId, financialYearId, id])
  @@unique([companyId, financialYearId, bookName])
  @@unique([companyId, financialYearId, prefix])
  @@map("production_books")
}

enum ProductionReceiveStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

model ProductionReceive {
  id               String                  @id @default(uuid())
  companyId        String                  @map("company_id")
  financialYearId  String                  @map("financial_year_id")
  productionBookId String                  @map("production_book_id")
  challanNumber    String                  @map("challan_number")
  challanDate      DateTime                @map("challan_date")
  partyId          String?                 @map("party_id")
  machineId        String?                 @map("machine_id")
  operatorId       String?                 @map("operator_id")
  yarnQualityId    String?                 @map("yarn_quality_id")
  yarnGradeId      String?                 @map("yarn_grade_id")
  lotNumber        String?                 @map("lot_number")
  twist            String?
  emptyCopsWeight  Decimal                 @default(0.000) @db.Decimal(10, 3) @map("empty_cops_weight")
  locationId       String?                 @map("location_id")
  remarks          String?
  status               ProductionReceiveStatus @default(DRAFT)
  cancellationReason   String?                 @map("cancellation_reason")
  cancelledAt          DateTime?               @map("cancelled_at")
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")

  company         Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  financialYear   FinancialYear           @relation(fields: [companyId, financialYearId], references: [companyId, id], onDelete: Restrict)
  productionBook  ProductionBook          @relation(fields: [companyId, financialYearId, productionBookId], references: [companyId, financialYearId, id], onDelete: Restrict)
  party           Party?                  @relation(fields: [companyId, partyId], references: [companyId, id], onDelete: Restrict)
  machine         Machine?                @relation(fields: [companyId, machineId], references: [companyId, id], onDelete: Restrict)
  operator        Operator?               @relation(fields: [companyId, operatorId], references: [companyId, id], onDelete: Restrict)
  yarnQuality     YarnQuality?            @relation(fields: [companyId, yarnQualityId], references: [companyId, id], onDelete: Restrict)
  yarnGrade       YarnGrade?              @relation(fields: [companyId, yarnGradeId], references: [companyId, id], onDelete: Restrict)
  location        Location?               @relation(fields: [companyId, locationId], references: [companyId, id], onDelete: Restrict)
  items           ProductionReceiveItem[]
  purchaseBill    PurchaseBill?           @relation("ChallanToPurchaseBill")

  @@unique([companyId, financialYearId, productionBookId, challanNumber])
  @@index([companyId, financialYearId, challanDate])
  @@index([companyId, partyId])
  @@map("production_receives")
}

model ProductionReceiveItem {
  id                  String   @id @default(uuid())
  productionReceiveId String   @map("production_receive_id")
  cartonNumber        String   @map("carton_number")
  cartonWeight        Decimal  @db.Decimal(10, 3) @map("carton_weight")
  cops                Int
  grossWeight         Decimal  @db.Decimal(10, 3) @map("gross_weight")
  copsWeight          Decimal  @db.Decimal(10, 3) @map("cops_weight")
  tareWeight          Decimal  @db.Decimal(10, 3) @map("tare_weight")
  netWeight           Decimal  @db.Decimal(10, 3) @map("net_weight")
  twist               String?
  lotNumber           String?  @map("lot_number")
  grade               String?
  averageWeight       Decimal  @db.Decimal(10, 3) @map("average_weight")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  productionReceive ProductionReceive @relation(fields: [productionReceiveId], references: [id], onDelete: Cascade)

  @@unique([productionReceiveId, cartonNumber])
  @@index([productionReceiveId])
  @@map("production_receive_items")
}

enum PurchaseBillStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

model PurchaseBill {
  id                    String             @id @default(uuid())
  companyId             String             @map("company_id")
  financialYearId       String             @map("financial_year_id")
  billNumber            String             @map("bill_number")
  billDate              DateTime           @map("bill_date")
  sourceChallanId       String?            @unique @map("source_challan_id")
  partyId               String?            @map("party_id")
  supplierGstin         String?            @map("supplier_gstin")
  supplierLegalName     String             @map("supplier_legal_name")
  supplierTradeName     String?            @map("supplier_trade_name")
  supplierAddress       String?            @map("supplier_address")
  supplierState         String?            @map("supplier_state")
  supplierStateCode     String?            @map("supplier_state_code")
  supplierPincode       String?            @map("supplier_pincode")
  supplierCity          String?            @map("supplier_city")
  verificationSource    String             @default("MANUAL_UNVERIFIED") @map("verification_source")
  verificationTimestamp DateTime?          @map("verification_timestamp")
  isVerifiedSupplier    Boolean            @default(false) @map("is_verified_supplier")
  supplierInvoiceNumber String?            @map("supplier_invoice_number")
  supplierInvoiceDate   DateTime?          @map("supplier_invoice_date")
  placeOfSupply         String?            @map("place_of_supply")
  totalQuantity         Decimal            @default(0.000) @db.Decimal(12, 3) @map("total_quantity")
  taxableAmount         Decimal            @default(0.00) @db.Decimal(15, 2) @map("taxable_amount")
  cgstRate              Decimal            @default(0.00) @db.Decimal(5, 2) @map("cgst_rate")
  cgstAmount            Decimal            @default(0.00) @db.Decimal(15, 2) @map("cgst_amount")
  sgstRate              Decimal            @default(0.00) @db.Decimal(5, 2) @map("sgst_rate")
  sgstAmount            Decimal            @default(0.00) @db.Decimal(15, 2) @map("sgst_amount")
  igstRate              Decimal            @default(0.00) @db.Decimal(5, 2) @map("igst_rate")
  igstAmount            Decimal            @default(0.00) @db.Decimal(15, 2) @map("igst_amount")
  roundOff              Decimal            @default(0.00) @db.Decimal(10, 2) @map("round_off")
  totalAmount           Decimal            @default(0.00) @db.Decimal(15, 2) @map("total_amount")
  status                PurchaseBillStatus @default(CONFIRMED)
  remarks               String?
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  company       Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  financialYear FinancialYear      @relation(fields: [companyId, financialYearId], references: [companyId, id], onDelete: Restrict)
  party         Party?             @relation(fields: [companyId, partyId], references: [companyId, id], onDelete: Restrict)
  sourceChallan ProductionReceive? @relation("ChallanToPurchaseBill", fields: [sourceChallanId], references: [id], onDelete: Restrict)
  items         PurchaseBillItem[]

  @@unique([companyId, financialYearId, billNumber])
  @@index([companyId, financialYearId, billDate])
  @@index([companyId, supplierGstin])
  @@map("purchase_bills")
}

model PurchaseBillItem {
  id             String   @id @default(uuid())
  purchaseBillId String   @map("purchase_bill_id")
  itemDescription String  @map("item_description")
  hsnCode        String?  @map("hsn_code")
  quantity       Decimal  @db.Decimal(12, 3)
  unit           String   @default("KG")
  rate           Decimal  @db.Decimal(15, 2)
  discount       Decimal  @default(0.00) @db.Decimal(15, 2)
  taxableAmount  Decimal  @db.Decimal(15, 2) @map("taxable_amount")
  cartonNumber   String?  @map("carton_number")
  lotNumber      String?  @map("lot_number")
  grade          String?
  cops           Int?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  purchaseBill PurchaseBill @relation(fields: [purchaseBillId], references: [id], onDelete: Cascade)

  @@index([purchaseBillId])
  @@map("purchase_bill_items")
}

// =============================================================
// Phase 12 — Ledger Accounts & Bank Vouchers (Bank Receipt / Payment)
// =============================================================

enum LedgerAccountGroup {
  BANK
  SUNDRY_DEBTORS
  SUNDRY_CREDITORS
  DIRECT_EXPENSES
  INDIRECT_EXPENSES
  DIRECT_INCOME
  INDIRECT_INCOME
  ASSETS
  LIABILITIES
  CAPITAL
  OTHERS
}

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum BankVoucherType {
  RECEIPT
  PAYMENT
}

enum PaymentMode {
  NEFT
  RTGS
  IMPS
  CHEQUE
  UPI
  BANK_TRANSFER
  OTHER
}

enum BankVoucherStatus {
  POSTED
  CANCELLED
}

model LedgerAccount {
  id                String             @id @default(uuid())
  companyId         String             @map("company_id")
  accountCode       String             @map("account_code")
  accountName       String             @map("account_name")
  accountGroup      LedgerAccountGroup @map("account_group")
  accountType       LedgerAccountType  @map("account_type")
  balanceType       BalanceType        @default(DEBIT) @map("balance_type")
  openingBalance    Decimal            @default(0.00) @db.Decimal(15, 2) @map("opening_balance")
  isBankAccount     Boolean            @default(false) @map("is_bank_account")
  bankName          String?            @map("bank_name")
  branchName        String?            @map("branch_name")
  accountHolderName String?            @map("account_holder_name")
  ifscCode          String?            @map("ifsc_code")
  bankAccountNumber String?            @map("bank_account_number")
  partyId           String?            @map("party_id")
  isAutoCreated     Boolean            @default(false) @map("is_auto_created")
  description       String?
  isActive          Boolean            @default(true) @map("is_active")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  company              Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  party                Party?        @relation(fields: [companyId, partyId], references: [companyId, id], onDelete: Restrict)
  journalLines         JournalLine[]
  bankAccountVouchers  BankVoucher[] @relation("BankAccountVoucher")
  counterpartyVouchers BankVoucher[] @relation("CounterpartyVoucher")

  @@unique([companyId, id])
  @@unique([companyId, accountCode])
  @@index([companyId, accountName])
  @@index([companyId, accountGroup])
  @@index([companyId, isBankAccount, isActive])
  @@map("ledger_accounts")
}

model BankVoucher {
  id                   String            @id @default(uuid())
  companyId            String            @map("company_id")
  financialYearId      String            @map("financial_year_id")
  voucherType          BankVoucherType @map("voucher_type")
  voucherNumber        String            @map("voucher_number")
  voucherDate          DateTime          @map("voucher_date")
  partyId              String?           @map("party_id")
  counterpartyLedgerId String            @map("counterparty_ledger_id")
  bankAccountLedgerId  String            @map("bank_account_ledger_id")
  paymentMode          PaymentMode       @map("payment_mode")
  amount               Decimal           @db.Decimal(15, 2)
  referenceNumber      String?           @map("reference_number")
  chequeNumber         String?           @map("cheque_number")
  chequeDate           DateTime?         @map("cheque_date")
  bankName             String?           @map("bank_name")
  branchName           String?           @map("branch_name")
  narration            String?
  remarks              String?
  status               BankVoucherStatus @default(POSTED)
  revision             Int               @default(1)
  cancellationReason   String?           @map("cancellation_reason")
  cancelledAt          DateTime?         @map("cancelled_at")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  company            Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  financialYear       FinancialYear     @relation(fields: [companyId, financialYearId], references: [companyId, id], onDelete: Restrict)
  party               Party?            @relation(fields: [companyId, partyId], references: [companyId, id], onDelete: Restrict)
  counterpartyLedger  LedgerAccount     @relation("CounterpartyVoucher", fields: [companyId, counterpartyLedgerId], references: [companyId, id], onDelete: Restrict)
  bankAccountLedger   LedgerAccount     @relation("BankAccountVoucher", fields: [companyId, bankAccountLedgerId], references: [companyId, id], onDelete: Restrict)
  journalLines        JournalLine[]

  @@unique([companyId, financialYearId, voucherType, voucherNumber])
  @@unique([companyId, id])
  @@index([companyId, financialYearId, voucherDate])
  @@index([companyId, voucherType, status])
  @@index([companyId, partyId])
  @@map("bank_vouchers")
}

model JournalLine {
  id               String   @id @default(uuid())
  companyId        String   @map("company_id")
  financialYearId  String   @map("financial_year_id")
  voucherId        String   @map("voucher_id")
  ledgerAccountId  String   @map("ledger_account_id")
  revision         Int      @default(1)
  lineNumber       Int      @map("line_number")
  debitAmount      Decimal  @default(0.00) @db.Decimal(15, 2) @map("debit_amount")
  creditAmount     Decimal  @default(0.00) @db.Decimal(15, 2) @map("credit_amount")
  isReversal       Boolean  @default(false) @map("is_reversal")
  postingDate      DateTime @map("posting_date")
  narration        String?
  createdAt        DateTime @default(now()) @map("created_at")

  company       Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  financialYear FinancialYear @relation(fields: [companyId, financialYearId], references: [companyId, id], onDelete: Restrict)
  voucher       BankVoucher   @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  ledgerAccount LedgerAccount @relation(fields: [companyId, ledgerAccountId], references: [companyId, id], onDelete: Restrict)

  @@index([companyId, financialYearId, ledgerAccountId])
  @@index([companyId, voucherId])
  @@map("journal_lines")
}

model VoucherSequence {
  id              String          @id @default(uuid())
  companyId       String          @map("company_id")
  financialYearId String          @map("financial_year_id")
  voucherType     BankVoucherType @map("voucher_type")
  lastNumber      Int             @default(0) @map("last_number")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  financialYear FinancialYear @relation(fields: [companyId, financialYearId], references: [companyId, id], onDelete: Cascade)

  @@unique([companyId, financialYearId, voucherType])
  @@map("voucher_sequences")
}

// ---------------------------------------------------------------------------
// Phase 13 - Sales Orders & Purchase Orders
// ---------------------------------------------------------------------------

enum UnitOfMeasure {
  KG
  GRAM
  METER
  YARD
  PIECE
  ROLL
  BOX
  CARTON
  PACKET
  NOS
}

enum ItemType {
  YARN
  RAW_MATERIAL
  FABRIC
  OTHER
}

enum OrderDocumentType {
  SALES_ORDER
  PURCHASE_ORDER
}

enum OrderTaxType {
  INTRA_STATE
  INTER_STATE
}

enum OrderPriority {
  NORMAL
  URGENT
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_FULFILLED
  FULFILLED
  CLOSED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  SENT
  ACKNOWLEDGED
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

enum OrderHistoryAction {
  CREATED
  UPDATED
  CONFIRMED
  APPROVED
  SENT
  ACKNOWLEDGED
  COPIED
  CANCELLED
  STATUS_CHANGED
  FULFILMENT_RECORDED
}

enum OrderFulfilmentDocumentType {
  SALES_INVOICE
  DELIVERY_CHALLAN
  PURCHASE_BILL
  GOODS_RECEIPT
}

model Item {
  id                  String        @id @default(uuid())
  companyId           String        @map("company_id")
  itemCode            String        @map("item_code")
  itemName            String        @map("item_name")
  itemCategory        String?       @map("item_category")
  itemType            ItemType      @default(OTHER) @map("item_type")
  unit                UnitOfMeasure @default(KG)
  hsnCode             String?       @map("hsn_code")
  gstRate             Decimal       @default(18.00) @db.Decimal(5, 2) @map("gst_rate")
  defaultSalesRate    Decimal       @default(0.0000) @db.Decimal(15, 4) @map("default_sales_rate")
  defaultPurchaseRate Decimal       @default(0.0000) @db.Decimal(15, 4) @map("default_purchase_rate")
  barcode             String?
  description         String?
  yarnQualityId       String?       @map("yarn_quality_id")
  yarnGradeId         String?       @map("yarn_grade_id")
  yarnCount           String?       @map("yarn_count")
  denier              String?
  lotNumber           String?       @map("lot_number")
