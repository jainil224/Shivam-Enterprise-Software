  yarnCount            String?       @map("yarn_count")
  denier               String?
  colour               String?
  design               String?
  specification        String?
  unit                 UnitOfMeasure @default(KG)
  quantity             Decimal       @db.Decimal(15, 3)
  rate                 Decimal       @db.Decimal(15, 4)
  discountPercent      Decimal       @default(0.00) @db.Decimal(5, 2) @map("discount_percent")
  discountAmount       Decimal       @default(0.00) @db.Decimal(15, 2) @map("discount_amount")
  taxableAmount        Decimal       @default(0.00) @db.Decimal(15, 2) @map("taxable_amount")
  gstRate              Decimal       @default(0.00) @db.Decimal(5, 2) @map("gst_rate")
  cgstAmount           Decimal       @default(0.00) @db.Decimal(15, 2) @map("cgst_amount")
  sgstAmount           Decimal       @default(0.00) @db.Decimal(15, 2) @map("sgst_amount")
  igstAmount           Decimal       @default(0.00) @db.Decimal(15, 2) @map("igst_amount")
  lineTotal            Decimal       @default(0.00) @db.Decimal(15, 2) @map("line_total")
  expectedDeliveryDate DateTime?     @map("expected_delivery_date")
  remarks              String?
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  order     SalesOrder           @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  item      Item?                @relation(fields: [companyId, itemId], references: [companyId, id], onDelete: Restrict)
