  taxableAmount             Decimal           @default(0.00) @db.Decimal(15, 2) @map("taxable_amount")
  cgstAmount                Decimal           @default(0.00) @db.Decimal(15, 2) @map("cgst_amount")
  sgstAmount                Decimal           @default(0.00) @db.Decimal(15, 2) @map("sgst_amount")
  igstAmount                Decimal           @default(0.00) @db.Decimal(15, 2) @map("igst_amount")
  freightAmount             Decimal           @default(0.00) @db.Decimal(15, 2) @map("freight_amount")
  packingAmount             Decimal           @default(0.00) @db.Decimal(15, 2) @map("packing_amount")
  otherCharges              Decimal           @default(0.00) @db.Decimal(15, 2) @map("other_charges")
  roundOffAmount            Decimal           @default(0.00) @db.Decimal(15, 2) @map("round_off_amount")
  grandTotal                Decimal           @default(0.00) @db.Decimal(15, 2) @map("grand_total")
  scheduleIsPartial         Boolean           @default(false) @map("schedule_is_partial")
  narration                 String?
  remarks                   String?
