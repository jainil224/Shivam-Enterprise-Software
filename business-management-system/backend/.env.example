# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# PostgreSQL Database Connection URL (Prisma)
# Replace placeholder credentials with your local PostgreSQL user, password, and port
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/business_management?schema=public"


# GSTIN Verification Provider (Phase 11) - https://www.gstinapi.in
# Provider: gstinapi (live) | sandbox (offline fixtures) | none (disabled)
GSTIN_PROVIDER=gstinapi
# Server-side API key only. Never commit a real key.
GSTIN_API_KEY=gak_your_api_key_here
GSTIN_API_BASE_URL=https://www.gstinapi.in
